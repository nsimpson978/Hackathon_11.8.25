<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="pane_AnchorPane"
            xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sceneController"
            prefHeight="400.0" prefWidth="600.0">

    <children>

        <TextArea fx:id="journal_TextArea"
                  layoutX="288.0" layoutY="23.0"
                  prefHeight="225.0" prefWidth="280.0"
                  promptText="Write your thoughts here..." />


       <Button fx:id="save_Button"
                   layoutX="288.0"
                   layoutY="290.0"
                   prefWidth="150.0"
                   onAction="#save_Button_clicked"
                   text="Save &amp; Analyze" />


        <ImageView fx:id="Image_ImageView"
                   layoutX="30.0" layoutY="40.0"
                   fitHeight="180.0" fitWidth="220.0"
                   preserveRatio="true"
                   pickOnBounds="true"/>

        <Label fx:id="tip_Label"
               layoutX="30.0" layoutY="230.0"
               prefWidth="220.0" wrapText="true"
               style="-fx-font-size: 13px;" />

        <Label fx:id="emotion_Label"
               layoutX="288.0" layoutY="350.0"
               prefWidth="250.0"
               style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    </children>
</AnchorPane>
